pe\":\"uint256\",\"name\":\"srcAmount\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"minReturn\",\"type\":\"uint256\"},{\"internalType\":\"bytes\",\"name\":\"data\",\"type\":\"bytes\"}],\"name\":\"settleViaSwap\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"usdg\",\"outputs\":[{\"internalType\":\"contract IERC20\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"errors\":{\"SafeERC20FailedOperation(address)\":[{\"details\":\"An operation with an ERC-20 token failed.\"}]},\"kind\":\"dev\",\"methods\":{},\"stateVariables\":{\"authorised\":{\"details\":\"contracts allowed to trigger payouts (the Hedge contract)\"}},\"title\":\"SettlementRouter - routes winning USDG payouts (1inch Aqua / SwapVM integration point)\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"settle(address,uint256)\":{\"notice\":\"Default route: release USDG from the confidential reserve to the winner.\"},\"settleViaAqua(address,uint256)\":{\"notice\":\"Route the payout by pulling USDG from a 1inch Aqua shared-liquidity source, then paying         the winner directly. Used when the direct reserve should stay untouched.\"},\"settleViaSwap(address,uint256,uint256,uint256,bytes)\":{\"notice\":\"Route the payout by swapping a reserve asset into USDG via the 1inch aggregation router         (calldata `data` built off-chain), then paying the winner.\"}},\"notice\":\"Sits between `ContingentHedge` and the money. By default it releases USDG from the         confidential reserve (`ConfidentialUSDG.releaseTo`). When configured, it can instead:           1. **Swap** a non-USDG reserve asset into USDG via the 1inch aggregation router, or           2. **Pull** USDG liquidity from a 1inch **Aqua** shared-liquidity source         before paying the winner. This is where Contingent plugs into 1inch for settlement         liquidity + payout routing; the direct path keeps the MVP self-contained and testable.         Full Aqua/SwapVM wiring reuses the vendored 1inch aqua + swap-vm libraries (as in the         sibling Bulwark project); the typed interfaces here are the integration seams.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/SettlementRouter.sol\":\"SettlementRouter\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@cofhe/foundry-plugin/=node_modules/@cofhe/foundry-plugin/\",\":@cofhe/mock-contracts/=node_modules/@cofhe/mock-contracts/\",\":@fhenixprotocol/cofhe-contracts/=node_modules/@fhenixprotocol/cofhe-contracts/\",\":@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/\",\":@openzeppelin/uniswap-hooks/=lib/uniswap-hooks/\",\":@uniswap/v4-core/=lib/uniswap-hooks/lib/v4-core/\",\":@uniswap/v4-periphery/=lib/uniswap-hooks/lib/v4-periphery/\",\":forge-std/=lib/forge-std/src/\",\":hardhat/=lib/forge-std/src/\",\":hookmate/=lib/hookmate/src/\",\":permit2/=lib/uniswap-hooks/lib/v4-periphery/lib/permit2/\",\":solmate/=lib/uniswap-hooks/lib/v4-core/lib/solmate/\",\":v4-core/=lib/uniswap-hooks/lib/v4-core/\",\":v4-periphery/=lib/uniswap-hooks/lib/v4-periphery/\"],\"viaIR\":true},\"sources\":{\"node_modules/@fhenixprotocol/cofhe-contracts/FHE.sol\":{\"keccak256\":\"0xf2f826c0cef8c13236945bc25685cfc61921009d97ee5aa6b2e9e9fb8514c24e\",\"license\":\"BSD-3-Clause-Clear\",\"urls\":[\"bzz-raw://13fec3f2486560b7fbda29edb02bf7a09737c190e59f92c45a67b34d053230a9\",\"dweb:/ipfs/QmVJsTbRnan429pkRKWjG23xjW6MBgghNFBUdjUhCTh6ep\"]},\"node_modules/@fhenixprotocol/cofhe-contracts/ICofhe.sol\":{\"keccak256\":\"0x2c4f0961019dce4fcd8f7aa843f47cbd37591d6bef5641f8e7f6103c4aa8ef62\",\"license\":\"UNLICENSED\",\"urls\":[\"bzz-raw://f07df3ccd60adcb330ceca12bd7924e2b3937fb72993624b9153783cc03b7816\",\"dweb:/ipfs/QmWyU25KtHFJzy4P5DuzuzxqGGubWLRRjuEc26TAznjnwC\"]},\"node_modules/@openzeppelin/contracts/interfaces/IERC1363.sol\":{\"keccak256\":