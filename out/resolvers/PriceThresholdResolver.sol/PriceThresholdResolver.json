ility\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"eventId\",\"type\":\"bytes32\"},{\"internalType\":\"address\",\"name\":\"feed\",\"type\":\"address\"},{\"internalType\":\"int256\",\"name\":\"threshold\",\"type\":\"int256\"},{\"internalType\":\"bool\",\"name\":\"below\",\"type\":\"bool\"},{\"internalType\":\"uint64\",\"name\":\"deadline\",\"type\":\"uint64\"}],\"name\":\"register\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"name\":\"thresholds\",\"outputs\":[{\"internalType\":\"contract AggregatorV3Interface\",\"name\":\"feed\",\"type\":\"address\"},{\"internalType\":\"int256\",\"name\":\"threshold\",\"type\":\"int256\"},{\"internalType\":\"bool\",\"name\":\"below\",\"type\":\"bool\"},{\"internalType\":\"uint64\",\"name\":\"deadline\",\"type\":\"uint64\"},{\"internalType\":\"bool\",\"name\":\"exists\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"outcome(bytes32)\":{\"params\":{\"eventId\":\"identifier of the event being hedged.\"},\"returns\":{\"resolved\":\"true once the outcome is final.\",\"yes\":\"    the outcome: true = event happened (YES), false = did not (NO).\"}}},\"title\":\"PriceThresholdResolver - objective, oracle-resolved event outcomes\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"Resolves \\\"did an on-chain price cross a threshold by a deadline?\\\" \\u2014 the canonical Contingent         MVP event (a depeg, a price breach). Deterministic and dispute-free: once the price crosses,         the outcome latches to YES; if the deadline passes without a cross, it resolves NO.         Port note (Zama to Fhenix): generalises the prior `OracleIntegration.sol` Chainlink wrapper         into a pluggable `IResolver`, so the same market/hedge layer works with any resolver         (price feed here; a UMA opti